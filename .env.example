# CHARUTEI — exemplo de variáveis de ambiente. COPIE para .env (gitignored) e preencha.
# NUNCA comite segredos. Por padrão usamos provedores FAKE (zero custo, zero chave).

# --- Plano de dados local (docker-compose) ---
DATABASE_URL=postgresql+psycopg://charutei:charutei@localhost:5432/charutei
REDIS_URL=redis://localhost:6379/0

# --- Cascata cost-aware ---
# true  = stubs determinísticos (testes/CI, dev sem custo)
# false = provedores reais (ligue chave por slice ao testar de verdade)
USE_FAKE_PROVIDERS=true

# --- Provedores de modelo (ligados por slice; cascata os usa via interface) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# --- Observabilidade de IA (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Supabase (Auth/Storage — ligado na S6) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Auth real do BFF (S11): valida JWT HS256 do Supabase. Vazio = FakeAuthProvider (dev).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# --- Endurecimento do BFF (S19) ---
# production ativa padrões estritos + fail-fast de auth (exige SUPABASE_JWT_SECRET).
CHARUTEI_ENV=
# Origens CORS permitidas (CSV). Vazio: localhost em dev, [] em produção. NUNCA use `*`.
CHARUTEI_CORS_ORIGINS=
# Rate limit por cliente (janela deslizante). 0 desabilita.
CHARUTEI_RATE_LIMIT=300
CHARUTEI_RATE_WINDOW_S=60
