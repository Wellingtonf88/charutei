# Copie para .env (gitignored) e ajuste por ambiente.
# EXPO_PUBLIC_* é inlined no bundle pelo Expo — nunca coloque segredos aqui, só config pública.

# Simulador iOS/emulador com BFF local: http://localhost:8000
# Device físico na mesma rede: http://<IP da sua máquina>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
